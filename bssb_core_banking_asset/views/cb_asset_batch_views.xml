<openerp>
    <data>

        <record id="cb_asset_batch_view_search" model="ir.ui.view">
            <field name="name">cb_asset_batch - Search</field>
            <field name="model">cb_asset_batch</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <search>
                    <field name="id" />
                    <field name="name" />
                </search>
            </field>
        </record>

        <record id="cb_asset_batch_view_tree" model="ir.ui.view">
            <field name="name">cb_asset_batch - Tree</field>
            <field name="model">cb_asset_batch</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="id" optional="hide" />
                    <field name="name" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="cb_asset_batch_view_form" model="ir.ui.view">
            <field name="name">cb_asset_batch - Form</field>
            <field name="model">cb_asset_batch</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                            name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="oe_highlight"
                            attrs="{'invisible':[('state','!=','draft')]}"
                            confirm="Confirm batch. Are you sure?"
                        />
                        <button
                            name="action_send"
                            type="object"
                            string="Send"
                            class="oe_highlight"
                            attrs="{'invisible':[('state','!=','confirm')]}"
                            confirm="Send To Core Banking. Are you sure?"
                        />
                        <button
                            name="action_cancel"
                            type="object"
                            string="Cancel"
                            attrs="{'invisible':[('state','not in', ['draft', 'confirm'])]}"
                            confirm="Cancel batch. Are you sure?"
                        />
                        <button
                            name="action_restart"
                            type="object"
                            string="Restart"
                            attrs="{'invisible':[('state','&lt;&gt;', 'cancel')]}"
                            confirm="Restart batch. Are you sure?"
                        />
                        <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,confirm,done,cancel"
                        />
                    </header>
                    <sheet>
                        <div name="div_smart_buttons" class="oe_button_box" />
                        <group name="header" colspan="4" col="2">
                            <group name="header_left">
                                <field name="name" />
                                <field name="warehouse_id" />
                                <field name="depreciation_account_id" />
                                <field name="depreciation_expense_account_id" />
                            </group>
                            <group name="header_right">
                                <field name="is_admin" invisible="1"/>
                                <field name="cb_asset_backend_id" attrs="{'invisible': [('is_admin', '=', False )]}"/>
                                <field name="date" />
                                <field name="date_start" />
                                <field name="date_end" />
                            </group>
                        </group>
                        <notebook>
                            <page name="details" string="Details">
                                <group name="detail_1">
                                    <field name="depreciation_amount_method" />
                                    <field name="automatic_depreciation_amount" />
                                    <field name="manual_depreciation_amount" />
                                    <field name="final_depreciation_amount" />
                                </group>
                            </page>
                            <page name="description" string="Description">
                                <field name="description" colspan="4" nolabel="1" />
                            </page>
                            <page name="response" string="Response" attrs="{'invisible': [('is_admin', '=', False )]}">
                                <field name="response_msg" colspan="4" nolabel="1" attrs="{'invisible': [('is_admin', '=', False )]}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field
                                    name="message_follower_ids"
                                    widget="mail_followers"
                                    groups="base.group_user"
                                />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="cb_asset_batch_action" model="ir.actions.act_window">
            <field name="name">Asset Batches</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cb_asset_batch</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="cb_asset_batch_menu"
            name="Asset Batches"
            parent="fixed_asset.menu_finance_assets"
            action="cb_asset_batch_action"
            sequence="30"
        />
    </data>
</openerp>
