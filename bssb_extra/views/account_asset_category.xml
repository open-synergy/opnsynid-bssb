<openerp>
    <data>
        <record id="account_asset_category_view_form" model="ir.ui.view">
            <field name="name">account.asset.category.form</field>
            <field name="model">account.asset.category</field>
            <field name="inherit_id" ref="fixed_asset.account_asset_category_view_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='sequence_id']" position="after">
                        <field name="accounting_category_id"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="account_asset_category_view_search" model="ir.ui.view">
            <field name="name">account.asset.category.search</field>
            <field name="model">account.asset.category</field>
            <field name="inherit_id" ref="fixed_asset.account_asset_category_view_search"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="/search" position="inside">
                        <group>
                            <filter name="grp_accounting_category_id" string="Accounting Category" context="{'group_by':'accounting_category_id'}"/>
                        </group>
                    </xpath>
                </data>
            </field>
        </record>        

        <record id="account_asset_category_view_tree" model="ir.ui.view">
              <field name="name">account.asset.category.tree</field>
              <field name="model">account.asset.category</field>
              <field name="inherit_id" ref="fixed_asset.account_asset_category_view_tree"/>
              <field name="arch" type="xml">
                    <xpath expr="//field[@name='journal_id']" position="after">
                        <field name="accounting_category_id"/>
                    </xpath>              
              </field>
        </record>


    </data>
</openerp>
