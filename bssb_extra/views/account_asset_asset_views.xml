<openerp>
<data>
    <record id="account_asset_asset_view_tree" model="ir.ui.view">
        <field name="name">Inherit : Account Asset Accounting Tree</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="fixed_asset.account_asset_asset_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="accounting_category_id"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="method_number"/>
                <field name="method_period"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="account_asset_id" />
            </xpath>
        </field>
    </record>

    <record id="account_asset_asset_view_form" model="ir.ui.view">
        <field name="name">Inherit : Account Asset Accounting Form</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="fixed_asset.account_asset_asset_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="accounting_category_id"/>
            </xpath>        
            <xpath expr="//notebook" position="inside">
                <page name="accounting" string="Accounting">
                    <group name="accounting_1" colspan="4" col="2">
                        <field name="account_asset_id" />
                        <field name="account_depreciation_id" />
                        <field name="account_expense_depreciation_id" />
                        <field name="account_plus_value_id" />
                        <field name="account_min_value_id" />
                        <field name="account_residual_value_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</data>
</openerp>
